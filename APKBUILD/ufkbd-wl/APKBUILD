pkgname=ufkbd-wl
pkgver=4.2.3
pkgrel=0
pkgdesc="Unfettered keyboard wl version"
url="https://github.com/magdesign/unfettered-keyboard"
arch="aarch64"
license="GPL-3.0-only"
depends=""
makedepends="cargo rust git"
install=""
subpackages=""
source=""
builddir="$srcdir/$pkgname-$pkgver"

build() {
  cd "$srcdir"
  git clone --depth 1 https://github.com/magdesign/unfettered-keyboard.git
  cd "$srcdir/unfettered-keyboard"

  cargo build --release --bin ufkbd-wl
}

package() {
  cd "$srcdir/unfettered-keyboard"

  install -Dm755 target/release/ufkbd-wl "$pkgdir/usr/bin/ufkbd-wl"

  # The layouts are part of the package, installed with it by apk.
  install -Dm644 resources/layouts/*.xml \
    -t "$pkgdir/usr/share/unfettered-keyboard/layouts/"
}
